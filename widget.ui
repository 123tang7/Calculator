  <property name="styleSheet">
   <string notr="true">/* 1. 整体背景：深色（类似手机的深色模式） */
QWidget {
    background-color: #171717; /* 深黑灰 */
}

/* 2. 顶部显示屏：超大字体，靠右对齐，背景和外壳融为一体 */
QLineEdit {
    background-color: #171717;
    border: none;            /* 去掉边框 */
    color: #ffffff;          /* 纯白文字 */
    font-size: 56px;         /* 超大字体 */
    font-family: &quot;Segoe UI&quot;, Arial;
    padding-right: 15px;     /* 靠右留一点缝隙 */
    padding-top: 20px;
}

/* 3. 所有按钮的通用样式：无边框，圆角极大（变成圆形或胶囊形） */
QPushButton {
    background-color: #2e2e2e; /* 深灰底色 */
    border: none;
    border-radius: 35px;       /* 这个数值超过按钮高度一半就会变成完美的圆 */
    color: #ffffff;
    font-size: 28px;
    min-width: 70px;
    min-height: 70px;
}

/* 4. 鼠标悬停和按下反馈 */
QPushButton:hover { background-color: #3a3a3a; }
QPushButton:pressed { background-color: #4a4a4a; }

/* ================= 特殊按钮定制 ================= */

/* 顶部功能键 (C, CE, 退格等)：浅灰色 */
QPushButton#btnClear, 
QPushButton#btnBackspace, 
QPushButton#btnSign, 
QPushButton#btnDot {
    background-color: #a5a5a5;
    color: #000000;
}
QPushButton#btnClear:hover, 
QPushButton#btnBackspace:hover, 
QPushButton#btnSign:hover, 
QPushButton#btnDot:hover {
    background-color: #b8b8b8;
}

/* 运算符 (+, -, *, /)：亮橙色 */
QPushButton#btnAdd, 
QPushButton#btnSub, 
QPushButton#btnMul, 
QPushButton#btnDiv {
    background-color: #ff9f0a;
    color: #ffffff;
    font-size: 32px;
}
QPushButton#btnAdd:hover, 
QPushButton#btnSub:hover, 
QPushButton#btnMul:hover, 
QPushButton#btnDiv:hover {
    background-color: #ffb340;
}

/* 等号键：橙色 */
QPushButton#btnEqual {
    background-color: #ff9f0a;
    color: #ffffff;
    font-size: 32px;
}
QPushButton#btnEqual:hover { background-color: #ffb340; }</string>
